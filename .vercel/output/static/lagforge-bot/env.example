# Copy to .env and fill in. Never commit .env.

PAPER_TRADING=true
CONFIRM_LIVE=

# CoinSwitch PRO (Ed25519 hex pair from Profile → API Trading)
COINSWITCH_API_KEY=
COINSWITCH_SECRET_KEY=
COINSWITCH_BASE_URL=https://coinswitch.co

# Binance public market data does not need keys.
# Optional private REST (unused in paper mode).
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Capital
STARTING_CAPITAL_INR=10000
SLOT_COUNT=10
LEVERAGE=10

# Fees & gates (CoinSwitch futures taker defaults)
ENTRY_TAKER_FEE=0.00065
EXIT_TAKER_FEE=0.00065
SLIPPAGE_BUFFER=0.0005
MAX_TOB_PCT=0.25
MAX_SLIPPAGE_PCT=0.001

# Exits
HOLD_TIMEOUT_SEC=45
# Timeout only flattens when the close is net-green after fees. Losers wait for
# scratch or the hard vol stop — never a timeout loss.
MIN_STOP_PCT=0.0015
VOL_STOP_MULT=2.2

# Optional: if CoinSwitch WS is unreachable, lag Binance locally (paper only)
ALLOW_SYNTHETIC_LAG=false
SYNTHETIC_LAG_MS=220

# Persistence
SQLITE_PATH=lagforge.db

# Logging
LOG_LEVEL=INFO
