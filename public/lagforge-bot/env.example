# Copy to .env and fill in. Never commit .env.
# Never paste these values into the Grok desk or into chat.

PAPER_TRADING=true
CONFIRM_LIVE=

# Lag venue: COINSWITCH or COINDCX (lead is always Binance)
LAG_VENUE=COINSWITCH

# CoinSwitch PRO (Ed25519 hex pair from Profile → API Trading)
COINSWITCH_API_KEY=
COINSWITCH_SECRET_KEY=
COINSWITCH_BASE_URL=https://coinswitch.co

# CoinDCX futures (HMAC-SHA256 key pair from API settings)
COINDCX_API_KEY=
COINDCX_SECRET_KEY=
COINDCX_BASE_URL=https://api.coindcx.com

# Binance public market data does not need keys.
# Optional private REST (unused in paper mode).
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Capital
STARTING_CAPITAL_INR=10000
# Percent of the wallet that may be used for slots (1-100)
ALLOC_PCT=100
# Halt the session (flatten + stop) if marked loss reaches this INR. 0 = off.
MAX_SESSION_LOSS_INR=1000
SLOT_COUNT=10
LEVERAGE=10

# Fees & gates — leave blank to use the venue default
# CoinSwitch 0.065% / CoinDCX 0.05%+GST
ENTRY_TAKER_FEE=
EXIT_TAKER_FEE=
SLIPPAGE_BUFFER=0.0005
MAX_TOB_PCT=0.25
MAX_SLIPPAGE_PCT=0.001

# Exits
HOLD_TIMEOUT_SEC=45
# Timeout only flattens when the close is net-green after fees. Losers wait for
# scratch or the hard vol stop — never a timeout loss. Session max-loss is the
# only other path that can flatten a loser (it stops the whole loop).
MIN_STOP_PCT=0.0015
VOL_STOP_MULT=2.2

# Optional: if the lag venue WS is unreachable, lag Binance locally (paper only)
ALLOW_SYNTHETIC_LAG=false
SYNTHETIC_LAG_MS=220

# Persistence
SQLITE_PATH=lagforge.db

# Logging
LOG_LEVEL=INFO
