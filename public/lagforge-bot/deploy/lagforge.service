[Unit]
Description=LAGFORGE lead-lag paper/live bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/lagforge-bot
EnvironmentFile=/home/ubuntu/lagforge-bot/.env
ExecStart=/home/ubuntu/lagforge-bot/.venv/bin/python main.py
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
